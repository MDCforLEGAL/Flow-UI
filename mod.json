{
	"geode": "5.11.2",
	"gd": {
		"win": "2.2081",
		"android": "2.2081"
	},
	"id": "mdcforlegal.mdc_ui",
	"name": "MDC UI",
	"version": "1.0.1",
	"developer": "MDCforLEGAL",
	"description": "Modern, minimalist dark theme Flow UI mod for Geometry Dash.",
	"links": {
		"source": "https://github.com/MDCforLEGAL/Flow-UI"
	},
	"dependencies": {
		"geode.node-ids": ">=v1.23.3"
	},
	"settings": {
		"sound-effects": {
			"type": "bool",
			"name": "Ses Efektleri",
			"default": true
		},
		"darkness": {
			"type": "float",
			"name": "Karanlık Seviyesi",
			"default": 0.85,
			"min": 0.5,
			"max": 1.0,
			"control": {
				"slider": true
			}
		},
		"check-updates": {
			"type": "bool",
			"name": "Güncelleme Kontrolü",
			"description": "Başlangıçta GitHub Releases'ten güncelleme kontrol et",
			"default": true
		}
	}
}